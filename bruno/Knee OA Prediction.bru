meta {
  name: Predict Knee OA (v1)
  type: http
  seq: 1
}

post {
  url: http://localhost:8005/api/v1/predict
  body: multipartForm
  auth: none
}

body:multipart-form {
  file: @file()
}

docs {
  # Predict Knee OA (v1)
  
  Send a multipart/form-data POST request to predict Knee Osteoarthritis Kellgren-Lawrence Grade.
  
  1. Upload a PNG/JPEG knee X-ray image in the 'file' field.
  2. The response will contain the predicted KL grade (0-4), description, confidence, and class probabilities details.
}
