        <mxCell id="18" value="Select M_pred and M_true&#xa;Direct grade-specific evidence maps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="17">
          <mxGeometry x="130" y="60" width="350" height="80" as="geometry" />
        </mxCell>
        <mxCell id="19" value="Positive evidence + alignment&#xa;ReLU, bilinear upsample to 384x384" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="17">
          <mxGeometry x="130" y="180" width="350" height="80" as="geometry" />
        </mxCell>
        <mxCell id="20" value="Native CAM overlay and audit&#xa;Joint energy, border energy, predicted/true maps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="17">
          <mxGeometry x="130" y="300" width="350" height="80" as="geometry" />
        </mxCell>

        <mxCell id="21" value="Why the map is faithful: the same M_k is used for visualization and its spatial mean is exactly the class-k logit. No target-layer lookup and no gradient weighting are required." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="1">
