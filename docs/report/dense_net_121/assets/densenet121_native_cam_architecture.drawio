  <diagram id="densenet-native-cam" name="DenseNet-121 Native CAM">
    <mxGraphModel dx="1600" dy="1900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="2" value="DenseNet-121 for Kellgren-Lawrence Grading with Native Class Activation Maps" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="220" y="20" width="1160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="3" value="Input knee joint ROI&#xa;(B, 3, 384, 384)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="100" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="4" value="Laterality canonicalization&#xa;R knee: horizontal mirror | L knee: unchanged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="560" y="230" width="480" height="80" as="geometry" />
        </mxCell>
        <mxCell id="5" value="Deterministic spatial preprocessing&#xa;Square pad + CLAHE + resize 400 + crop 384 + normalize" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="520" y="360" width="560" height="90" as="geometry" />
        </mxCell>

        <mxCell id="6" value="DenseNet-121 feature backbone" style="swimlane;startSize=40;pointerEvents=0;rounded=0;whiteSpace=wrap;html=1;fillColor=#f7fbff;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="510" width="900" height="730" as="geometry" />
        </mxCell>
        <mxCell id="7" value="Stem&#xa;7x7 conv, stride 2 + 3x3 max pool&#xa;(B, 64, 96, 96)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="6">
          <mxGeometry x="220" y="70" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="8" value="Dense Block 1 (6 layers) + Transition 1&#xa;(B, 256, 96, 96) to (B, 128, 48, 48)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="6">
          <mxGeometry x="220" y="190" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="9" value="Dense Block 2 (12 layers) + Transition 2&#xa;(B, 512, 48, 48) to (B, 256, 24, 24)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="6">
          <mxGeometry x="220" y="310" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="10" value="Dense Block 3 (24 layers) + Transition 3&#xa;(B, 1024, 24, 24) to (B, 512, 12, 12)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="6">
          <mxGeometry x="220" y="430" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="11" value="Dense Block 4 (16 layers) + final norm/ReLU&#xa;Final semantic tensor F: (B, 1024, 12, 12)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="6">
          <mxGeometry x="220" y="550" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="12" value="1x1 class convolution&#xa;M = W * F + b&#xa;Five grade maps: (B, 5, 12, 12)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;" vertex="1" parent="6">
          <mxGeometry x="200" y="650" width="500" height="70" as="geometry" />
        </mxCell>

        <mxCell id="13" value="Classification branch" style="swimlane;startSize=40;pointerEvents=0;rounded=0;whiteSpace=wrap;html=1;fillColor=#fffaf3;strokeColor=#d79b00;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="1310" width="610" height="390" as="geometry" />
        </mxCell>
        <mxCell id="14" value="Global average pooling&#xa;logit_k = mean(M_k)&#xa;(B, 5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;fontStyle=1;" vertex="1" parent="13">
          <mxGeometry x="130" y="70" width="350" height="90" as="geometry" />
        </mxCell>
        <mxCell id="15" value="Softmax probabilities&#xa;Predicted KL grade = argmax(logits)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="13">
          <mxGeometry x="130" y="210" width="350" height="80" as="geometry" />
        </mxCell>
        <mxCell id="16" value="Cross-entropy loss&#xa;Target KL grade 0-4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="13">
          <mxGeometry x="130" y="320" width="350" height="60" as="geometry" />
        </mxCell>

        <mxCell id="17" value="Native CAM branch" style="swimlane;startSize=40;pointerEvents=0;rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#666666;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="1310" width="610" height="390" as="geometry" />
