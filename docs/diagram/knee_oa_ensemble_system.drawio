<mxfile host="app.diagrams.net" modified="2026-07-23T07:30:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="knee-oa-system" name="Knee OA Ensemble System">
    <mxGraphModel dx="1900" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Knee Osteoarthritis KL-Grading System" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="510" y="20" width="900" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="ROI detection -&gt; canonical preprocessing -&gt; soft-voting CNN ensemble -&gt; faithful native CAM" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#64748b;" vertex="1" parent="1">
          <mxGeometry x="460" y="70" width="1000" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="hdr_input" value="1  Detection and canonical input" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="xray" value="Bilateral knee X-ray" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="210" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="yolo" value="&lt;b&gt;YOLOv8 knee detector&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;find left/right joint ROIs&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="340" y="150" width="250" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="roi" value="Individual knee crops&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;one prediction per detected knee&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="150" width="250" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="preprocess" value="&lt;b&gt;Canonical preprocessing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;mirror right knees - square pad - CLAHE&lt;br&gt;resize 400 - center crop 384 - normalize&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1030" y="140" width="330" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="hdr_models" value="2  Parallel KL-grade inference" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="190" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="dense" value="&lt;b&gt;DenseNet-121&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;5 CE logits + faithful native CAM&lt;br&gt;stronger overall single-model metrics&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="250" y="390" width="290" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="seresnext" value="&lt;b&gt;SE-ResNeXt-50 32x4d&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;5 CE logits + faithful native CAM&lt;br&gt;current localization-oriented CAM source&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="650" y="390" width="310" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="efficientnet" value="&lt;b&gt;EfficientNet-B4 candidate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;MBConv + 24x24/12x12 native CAM&lt;br&gt;EMA checkpoint; not production yet&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1060" y="390" width="310" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="vote" value="&lt;b&gt;Equal soft vote&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;average 5-class probabilities&lt;br&gt;2 models now; 3 only after validation gate&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="800" y="650" width="300" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="candidate_gate" value="Candidate gate&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;validation score + CAM geometry + occlusion&lt;br&gt;then paired 2-model vs 3-model comparison&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1440" y="570" width="310" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="hdr_output" value="3  Prediction and explanation" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="heatmap" value="&lt;b&gt;Native-CAM renderer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;predicted-class SE-ResNeXt map&lt;br&gt;aligned to the canonical ROI crop&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="300" y="750" width="320" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="prediction" value="&lt;b&gt;KL prediction&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;grade 0-4 + confidence&lt;br&gt;five class probabilities&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1320" y="750" width="300" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="response" value="&lt;b&gt;Prediction API response&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;established JSON schema unchanged&lt;br&gt;prediction details + gradcam_image&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="790" y="920" width="360" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="training_note" value="Training note: the Kaggle data already contains individual knee crops, so YOLO is used in application inference, not in the CNN training notebooks." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="40" y="920" width="610" height="90" as="geometry"/>
