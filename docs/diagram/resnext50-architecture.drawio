Color=none;strokeWidth=0;fontColor=#111111;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=8;opacity=100;dashed=0;shadow=0;text;overflow=hidden;spacing=0" vertex="1" parent="1"><mxGeometry x="92" y="923" width="665" height="28" as="geometry" /></mxCell><mxCell id="n47" value="Important implementation boundary&#10;&#10;Checkpoint architecture id: final_native_cam_ce&#10;Classifier head can expose native class maps, but the API explanation is post-hoc&#10;predicted-class Grad-CAM from backbone.layer4. The ensemble does not average CAMs." style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#111111;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;spacing=8;opacity=100;dashed=0;shadow=0;" vertex="1" parent="1"><mxGeometry x="850" y="745" width="880" height="225" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="se-resnext50-stages" name="Stages and Cardinality"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="SE-ResNeXt-50 32x4d: Stages and Cardinality" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="80" y="30" width="1440" height="40" as="geometry" /></mxCell><mxCell id="sub" value="32x4d means 32 groups, each width 4, inside every grouped 3 x 3 convolution." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="80" y="75" width="1440" height="28" as="geometry" /></mxCell><mxCell id="in" value="Stem output&#10;96 x 96 x 64" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#111111;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="190" height="90" as="geometry" /></mxCell><mxCell id="l1" value="Layer 1&#10;3 bottlenecks&#10;96 x 96 x 256" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#111111;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="220" width="220" height="150" as="geometry" /></mxCell><mxCell id="l2" value="Layer 2&#10;4 bottlenecks&#10;48 x 48 x 512" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#111111;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="630" y="220" width="220" height="150" as="geometry" /></mxCell><mxCell id="l3" value="Layer 3&#10;6 bottlenecks&#10;24 x 24 x 1024" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#111111;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="220" width="220" height="150" as="geometry" /></mxCell><mxCell id="l4" value="Layer 4&#10;3 bottlenecks&#10;12 x 12 x 2048" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#111111;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1230" y="220" width="220" height="150" as="geometry" /></mxCell><mxCell id="note" value="Each bottleneck has one grouped convolution:&#10;32 independent groups x 4 channels = 128 channels in Layer 1." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#111111;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="550" width="700" height="90" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="in" ta