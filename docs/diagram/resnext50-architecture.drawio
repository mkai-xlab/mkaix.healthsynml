 y="260" width="180" height="90" as="geometry" /></mxCell><mxCell id="reduce" value="1 x 1 reduce&#10;64 -&gt; 128" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#111111;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="260" width="180" height="90" as="geometry" /></mxCell><mxCell id="grouped" value="3 x 3 grouped conv&#10;32 groups x 4 ch&#10;128 -&gt; 128" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#111111;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="550" y="240" width="230" height="130" as="geometry" /></mxCell><mxCell id="expand" value="1 x 1 expand&#10;128 -&gt; 256" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#111111;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="850" y="260" width="180" height="90" as="geometry" /></mxCell><mxCell id="se" value="SE channel scale&#10;256 gates" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#111111;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="260" width="180" height="90" as="geometry" /></mxCell><mxCell id="add" value="Residual add + ReLU&#10;96 x 96 x 256" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#111111;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1350" y="250" width="190" height="110" as="geometry" /></mxCell><mxCell id="skip" value="Projection skip&#10;64 -&gt; 256" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#111111;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="770" y="530" width="190" height="90" as="geometry" /></mxCell><mx