        </mxCell>
        <mxCell id="8" value="&lt;b&gt;Gradient Pooling&lt;/b&gt;&lt;br&gt;Global average pool -&gt; weights alpha_k" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1c4587;fontSize=12;align=center;" parent="1" vertex="1">
          <mxGeometry x="210" y="640" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;Weighted Sum &amp;amp; ReLU&lt;/b&gt;&lt;br&gt;L_CAM = ReLU( sum( alpha_k * A^k ) )" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1c4587;fontSize=12;align=center;" parent="1" vertex="1">
          <mxGeometry x="210" y="740" width="180" height="60" as="geometry" />
        </mxCell>
