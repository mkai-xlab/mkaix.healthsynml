        <mxCell id="5" value="&lt;b&gt;CORN Log-Probability Loss&lt;/b&gt;&lt;br&gt;Compute loss Y^c for class c" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#351c75;fontSize=12;align=center;" parent="1" vertex="1">
          <mxGeometry x="210" y="340" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;Backward Pass&lt;/b&gt;&lt;br&gt;Zero grad &amp;amp; run loss.backward()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1c4587;fontSize=12;align=center;" parent="1" vertex="1">
          <mxGeometry x="210" y="440" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;Save Gradients (dY/dA)&lt;/b&gt;&lt;br&gt;Backward hook retrieves gradients" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1c4587;fontSize=12;align=center;" parent="1" vertex="1">
