        <mxCell id="3" value="&lt;b&gt;Forward Pass&lt;/b&gt;&lt;br&gt;Register forward hook on norm5 layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1c4587;fontSize=12;align=center;" parent="1" vertex="1">
