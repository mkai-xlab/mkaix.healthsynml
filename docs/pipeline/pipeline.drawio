          <mxGeometry x="210" y="840" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="11" value="&lt;b&gt;OpenCV Overlay Blending&lt;/b&gt;&lt;br&gt;COLORMAP_JET &amp;amp; cv2.addWeighted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1c4587;fontSize=12;align=center;" parent="1" vertex="1">
